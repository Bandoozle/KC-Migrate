# WordPress backend for the AI chat and the temporary contact/newsletter relay (server-only).
# Page content and media are local (src/content/, public/wp-content/).
WORDPRESS_URL=https://staging.kosick.com

# ---------------------------------------------------------------------------
# Contact and newsletter forms (src/lib/forms/). With none of these set, both
# forms keep relaying to the WordPress Kadence forms exactly as before.
# Never commit real values: set them in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Phase 3a: store every submission in Supabase (Project Settings → API).
# Use the server "secret" key (sb_secret_…) or the legacy service_role key. Never NEXT_PUBLIC_.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=

# Keyed hash of the client IP, for rate limiting without storing addresses.
# Any long random string (e.g. `openssl rand -hex 32`); changing it resets the IP history.
# IP_HASH_SECRET=

# Phase 3b: send the notification and auto-response emails directly through Resend.
#   off   (default) WordPress sends them
#   test  every email goes only to FORMS_TEST_TO, subject marked with the intended recipient
#   live  notification to FORMS_NOTIFY_TO, auto-response to the visitor
# Do not run `live` while FORMS_WORDPRESS_RELAY is on, or both systems email everyone.
# FORMS_EMAIL=off
# RESEND_API_KEY=
# FORMS_FROM=Kosick Communications Ltd. <info@kosick.com>
# FORMS_NOTIFY_TO=info@kosick.com
# FORMS_NOTIFY_BCC=
# FORMS_TEST_TO=
# FORMS_ALERT_TO=info@kosick.com

# The relay to the WordPress Kadence forms. Set to `off` once the Supabase + Resend
# path has passed live tests.
# FORMS_WORDPRESS_RELAY=on

# Protects /api/forms/retry/ (Authorization: Bearer <CRON_SECRET>). Any long random string.
# CRON_SECRET=

# Cloudflare Turnstile. Set both or neither: with only the secret, every submission fails.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is read at build time, so redeploy after changing it.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Analytics — reuse existing Kosick GTM/GA4 (do not invent new IDs)
# NEXT_PUBLIC_GTM_ID=GTM-K4QK6SP
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XPYR1CEF3E
#
# Analytics loads only when the request host is www.kosick.com or kosick.com,
# so Vercel preview and *.vercel.app URLs never send data.
#   NEXT_PUBLIC_ANALYTICS_ENABLED=true   forces it on (debug sessions only)
#   NEXT_PUBLIC_ANALYTICS_ENABLED=false  forces it off everywhere
# Leave it unset in Production.
